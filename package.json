{
  "name": "raumakustik-digital-twin",
  "version": "0.3.1",
  "description": "3D-Raumakustik mit direkter Sweep-Messung, Pegelabgleich und KI-Analyse",
  "author": "Raumakustik",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "dist:win": "npm run check && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:editor": "node scripts/smoke-editor.mjs",
    "test:audio": "bash scripts/with-display.sh node scripts/smoke-audio.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "de.raumakustik.digitaltwin",
    "productName": "Raumakustik Digital Twin",
    "artifactName": "Raumakustik-${version}-${arch}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "src/core/**/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Petzi2712",
        "repo": "Raumakustik",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "script": "build/installer.nsi",
      "allowElevation": false,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "type": "module"
}
